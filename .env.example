# Copy to .env and adjust. Every value below is optional — app/config.py defines a
# working default for each, so an empty .env runs fine for local development.
# Never commit a real .env; it is gitignored and blocked by .claude/hooks/protect_env.py.

# --- Application -----------------------------------------------------------
APP_NAME="RAG Document Assistant"
APP_VERSION="0.1.0"
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Uploads (Phase 1) -----------------------------------------------------
UPLOAD_DIR=data/uploads
# Maximum accepted upload, in bytes (20 MB).
MAX_UPLOAD_BYTES=20971520
# JSON array of accepted MIME types.
ALLOWED_CONTENT_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
# A DOCX is a zip; these bound decompression so a small upload cannot exhaust memory.
MAX_UNCOMPRESSED_BYTES=104857600
MAX_COMPRESSION_RATIO=100

# --- Chunking (Phase 2) ----------------------------------------------------
CHUNK_SIZE=800
# Must be at most half of CHUNK_SIZE, or the splitter stalls and drops document text.
CHUNK_OVERLAP=120
# JSON array. Note the newline must be escaped as \n — a raw newline is invalid JSON.
CHUNK_SEPARATORS=["\n\n","\n",". "," ",""]
MAX_CHUNKS_FILE_BYTES=33554432

# --- Embeddings & vector store (Phase 3) -----------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Pin the snapshot so a moved upstream `main` cannot be loaded silently.
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# true skips ~20 HuggingFace revalidation calls at startup. Leave false for the first
# run, which populates the cache, then set true for fast offline starts.
EMBEDDING_LOCAL_FILES_ONLY=false
# cpu keeps the GPU's VRAM free for Ollama.
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_MAX_TOKENS=256

CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=documents
# Only "cosine" is supported; score = 1 - distance depends on it.
CHROMA_DISTANCE=cosine
SEARCH_TOP_K=5

# --- Generation (Phase 4) --------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Must be pulled first: ollama pull qwen2.5:7b
GENERATION_MODEL=qwen2.5:7b
# Low temperature keeps answers faithful to the retrieved context.
GENERATION_TEMPERATURE=0.2
# Chunks retrieved as context for each answer.
GENERATION_TOP_K=5
GENERATION_NUM_CTX=8192
REQUEST_TIMEOUT_S=120.0
